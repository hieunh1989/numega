# PostgreSQL local trong docker-compose.yml
DATABASE_URL=postgresql://numega:numega_local@localhost:5433/numega
DATABASE_POOL_MAX=10

# Local tự tạo tài khoản này nếu database chưa có user.
# Trên Vercel/VPS phải khai báo rõ hai biến và dùng mật khẩu mạnh riêng.
SEED_ADMIN_EMAIL=admin@numega.local
SEED_ADMIN_PASSWORD=Numega@123
